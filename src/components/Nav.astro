<nav aria-label="Primary navigation">
    <a href="#Experience"><span data-i18n="navExperience">Experience</span></a>
    <a href="#Projectsx"><span data-i18n="navProjects">Projects</span></a>
    <a href="#Skills"><span data-i18n="navSkills">Skills</span></a>
    <a href="#AboutMe"><span data-i18n="navAbout">About me</span></a>
</nav>

<script>
    const links = [...document.querySelectorAll("nav a")];
    const sections = links.map((link) => document.querySelector(link.getAttribute("href"))).filter(Boolean);
    const updateActive = () => {
        const marker = window.scrollY + window.innerHeight * 0.28;
        let active = sections[0];
        for (const section of sections) if (section.offsetTop <= marker) active = section;
        links.forEach((link) => {
            const isActive = link.getAttribute("href") === "#" + active.id;
            link.toggleAttribute("data-active", isActive);
            if (isActive) link.setAttribute("aria-current", "page"); else link.removeAttribute("aria-current");
        });
    };
    updateActive();
    window.addEventListener("scroll", updateActive, { passive: true });
</script>

<style>
    nav {
        width: min(720px, calc(100% - 28px));
        min-height: 52px;
        position: fixed;
        top: 14px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        justify-content: space-evenly;
        align-items: center;
        gap: 2px;
        padding: 4px 8px;
        background: rgba(16,16,23,.72);
        border: 1px solid rgba(255,255,255,.1);
        border-radius: 16px;
        z-index: 99999999;
        box-shadow: 0 14px 40px rgba(0,0,0,.28);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
    }
    a {
        flex: 1 1 0;
        min-width: 0;
        text-align: center;
        text-decoration: none;
        color: #a9a9b4;
        padding: 9px 10px;
        border-radius: 11px;
        transition: color .2s ease, background-color .2s ease, transform .2s ease;
    }
    span { border-bottom: 1px solid transparent; transition: border-color .2s ease; white-space: nowrap; }
    a:hover, a[data-active] { color: #fff; background: rgba(127,90,240,.13); }
    a:hover { transform: translateY(-1px); }
    a[data-active] span { border-bottom-color: #a78bfa; }
    @media (max-width: 850px) {
        nav { width: calc(100% - 16px); top: 8px; min-height: 46px; padding: 3px 4px; border-radius: 14px; }
        a { padding: 8px 4px; font-size: clamp(.68rem, 2.7vw, .8rem); }
    }
    @media (max-width: 390px) {
        nav { width: calc(100% - 10px); }
        a { padding-inline: 2px; font-size: .66rem; }
    }
    @media (prefers-reduced-motion: reduce) { a { transition: none; } }
</style>