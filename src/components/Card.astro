---
interface Props {
	title: string;
	desc: string;
	langs: Array<{ name: string; svg: string }>;
	image: string;
	source: string;
	live?: string;
}

const { title, desc, langs, image, source, live } = Astro.props;
---

<article class="project-card">
	<h1>{title}</h1>
	<p>{desc}</p>
	<div class="tech-list">
		{langs.map(lang => (
			<span class="lang"><img src={`/${lang.svg}`} alt={lang.name} />{lang.name}</span>
		))}
	</div>
	<img class="preview" src={`/${image}`} alt={title} />
	<section class="links">
		<a class="btn source" href={source} target="_blank" rel="noreferrer"><img src="/Github.svg" alt="GitHub" /><span>Source</span></a>
		{live ? (
			<a class="btn live" href={live} target="_blank" rel="noreferrer"><img src="/live.svg" alt="Live" /><span>Live</span></a>
		) : (
			<span class="btn no-live"><span>No Live</span></span>
		)}
	</section>
</article>

<style>
	article { width: 100%; margin: 54px auto; padding: 24px; border: 1px solid rgba(255,255,255,.07); border-radius: 22px; background: rgba(255,255,255,.025); box-shadow: 0 18px 55px rgba(0,0,0,.18); backdrop-filter: blur(10px); transition: transform .3s ease, border-color .3s ease, box-shadow .3s ease; color: aliceblue; position: relative; }
	h1 { position: relative; color: rgb(254 240 138); font-size: clamp(1.35rem, 2.2vw, 1.75rem); font-weight: 600; margin-bottom: 12px; padding-left: 20px; display: flex; align-items: center; overflow-wrap: anywhere; }
	h1::before { content: ""; flex: 0 0 10px; width: 10px; height: 10px; border-radius: 50%; background: rgb(254 240 138 / 90%); position: absolute; left: 0; top: 50%; transform: translateY(-50%); }
	p { font-size: clamp(.98rem, 1.3vw, 1.1rem); line-height: 1.6rem; margin-bottom: 25px; color: #dcdcdc; overflow-wrap: anywhere; }
	.tech-list { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 30px; }
	.lang { display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px; border-radius: 9999px; background: rgba(255,255,255,.08); font-size: .85rem; color: #ddd; backdrop-filter: blur(4px); line-height: 1; }
	.lang img { width: 16px; height: 16px; object-fit: contain; }
	.preview { display: block; margin: 40px auto 25px; max-width: 100%; max-height: 350px; border-radius: 12px; box-shadow: 0 15px 40px rgba(0,0,0,.3); }
	.links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 10px; }
	.btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-width: 0; padding: 10px 20px; border-radius: 9999px; font-size: 1rem; font-weight: 500; text-decoration: none; background: rgba(255,255,255,.06); color: white; backdrop-filter: blur(6px); transition: all .2s ease; line-height: 1.2; }
	.btn img { width: 20px; height: 20px; flex: 0 0 auto; }
	.btn:hover { transform: scale(1.05); background: rgba(255,255,255,.1); }
	.source { color: lightseagreen; } .live { color: limegreen; } .no-live { color: crimson; opacity: .5; cursor: default; pointer-events: none; background: rgba(255,255,255,.03); }
	@media (max-width: 850px) {
		article { margin: 30px auto; padding: 18px 14px; border-radius: 18px; }
		h1 { font-size: clamp(1.15rem, 5vw, 1.35rem); line-height: 1.3; }
		p { font-size: clamp(.9rem, 3.6vw, .98rem); line-height: 1.5rem; }
		.preview { margin: 26px auto 20px; width: 100%; height: auto; }
		.links { justify-content: stretch; }
		.btn { flex: 1 1 140px; padding: 9px 12px; font-size: clamp(.78rem, 3.2vw, .9rem); }
	}
	@media (max-width: 390px) { article { padding-inline: 12px; } .links { gap: 8px; } .btn { flex-basis: 100%; } }
	@media (prefers-reduced-motion: reduce) { .project-card, .btn { transition: none; } }
</style>