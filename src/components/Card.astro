---
interface Props {
	title: string;
	desc: string;
	langs: Array<{ name: string; svg?: string }>;
	image: string;
	source: string;
	live?: string;
}

const { title, desc, langs, image, source, live } = Astro.props;

type ProjectDetails = {
	title?: string;
	desc: string;
	langs: Array<{ name: string; svg?: string }>;
	image: string;
	source: string;
	priority: number;
	featured?: boolean;
	live?: string;
	liveLabel?: string;
};

const projectDetails: Record<string, ProjectDetails> = {
	"Apptesanos (Web/Mobile App)": {
		title: "Apptesanos — Ionic & Vue App",
		desc: "Base code of the Apptesanos app, a collaborative agricultural-supply project with Universidad de Cundinamarca. The repository includes Signup/SignIn, Firebase, profile and main-menu updates, image fixes, sales administration, and general bug fixes.",
		langs: [
			{ name: "Vue.js", svg: "langs/vue.svg" },
			{ name: "Ionic", svg: "langs/ionic.svg" },
			{ name: "TypeScript" },
			{ name: "Firebase" },
			{ name: "Capacitor" },
		],
		image: "Apptesanos.webp",
		source: "https://github.com/YourS4nty/ApptesanosApp",
		priority: 1,
		featured: true,
		live: "https://www.figma.com/file/hWhEkKPH2we11pcrYfhyFH/Apptesanos?type=design&node-id=0-1&mode=design",
		liveLabel: "Figma",
	},
	"Lornychi — Streamer & Vtuber Portfolio": {
		desc: "Web portfolio for streamer and Vtuber Lornychi, developed with Astro and Tailwind. It includes personal information, an art gallery, social links, and stream schedules in a responsive portfolio experience.",
		langs: [
			{ name: "Astro", svg: "langs/astro.svg" },
			{ name: "Tailwind CSS" },
		],
		image: "Lorny.webp",
		source: "https://github.com/YourS4nty/Lorny-s-Web",
		priority: 2,
		featured: true,
	},
	NoteGuard: {
		desc: "Noteguard is a simple note-taking application with password protection and expiration-date functionality. Built with Express and EJS, it uses Firebase for storage and node-cron for scheduled expiration handling.",
		langs: [
			{ name: "Node.js", svg: "langs/nodejs.svg" },
			{ name: "Express" },
			{ name: "EJS", svg: "langs/js.svg" },
			{ name: "Firebase" },
			{ name: "node-cron" },
		],
		image: "NoteGuard.webp",
		source: "https://github.com/YourS4nty/NoteGuard",
		priority: 3,
		featured: true,
	},
	"Rest Api": {
		title: "REST API — Node.js & Express",
		desc: "Versatile REST API built with Node.js and Express.js, providing services for QR-code generation, credit-card validation, binary encoding/decoding, password generation, and country and book information.",
		langs: [
			{ name: "JavaScript", svg: "langs/js.svg" },
			{ name: "Node.js", svg: "langs/nodejs.svg" },
			{ name: "Express" },
			{ name: "Axios" },
			{ name: "QRCode" },
			{ name: "UUID" },
			{ name: "lorem-ipsum" },
		],
		image: "Api.webp",
		source: "https://github.com/YourS4nty/Ys4Api",
		priority: 4,
	},
	"Sudoku Solver": {
		desc: "Sudoku-solving algorithm implemented in HTML, CSS, and vanilla JavaScript. It provides an intuitive graphical interface to enter a puzzle, solve it with the algorithm, and clearly visualize the original puzzle and its solution.",
		langs: [
			{ name: "HTML", svg: "langs/html.svg" },
			{ name: "CSS", svg: "langs/css.svg" },
			{ name: "JavaScript", svg: "langs/js.svg" },
		],
		image: "Sudoku.webp",
		source: "https://github.com/YourS4nty/SudokuSolver",
		priority: 5,
	},
	PokeDex: {
		title: "Pokédex — PokeAPI",
		desc: "Simple Pokédex web application developed with HTML, CSS, and vanilla JavaScript. It integrates PokeAPI to display Pokémon data and includes search, filtering, and responsive behavior for different devices.",
		langs: [
			{ name: "HTML", svg: "langs/html.svg" },
			{ name: "CSS", svg: "langs/css.svg" },
			{ name: "JavaScript", svg: "langs/js.svg" },
			{ name: "PokeAPI" },
		],
		image: "pokedex.webp",
		source: "https://github.com/YourS4nty/PokeDex",
		priority: 6,
	},
	"Ai Game (Basic)": {
		title: "Rock, Paper, Scissors — AI",
		desc: "Rock, Paper, Scissors game built with HTML, CSS, and vanilla JavaScript, featuring a built-in AI opponent, a minimalist interface, and round-based interaction.",
		langs: [
			{ name: "HTML", svg: "langs/html.svg" },
			{ name: "CSS", svg: "langs/css.svg" },
			{ name: "JavaScript", svg: "langs/js.svg" },
		],
		image: "aigame.webp",
		source: "https://github.com/YourS4nty/Ai-Game",
		priority: 7,
	},
};

const details = projectDetails[title];
const displayTitle = details?.title ?? title;
const displayDesc = details?.desc ?? desc;
const displayLangs = details?.langs ?? langs;
const displayImage = details?.image ?? image;
const displaySource = details?.source ?? source;
const displayLive = details?.live ?? live;
const liveLabel = details?.liveLabel ?? "Live";
const priority = details?.priority ?? 99;
const originalOrder: Record<string, number> = {
	NoteGuard: 0,
	"Rest Api": 1,
	"Lornychi — Streamer & Vtuber Portfolio": 2,
	"Sudoku Solver": 3,
	"Ai Game (Basic)": 4,
	"Apptesanos (Web/Mobile App)": 5,
	PokeDex: 6,
};
const order = originalOrder[title] ?? 99;
---

<article class:list={{ "featured-project": details?.featured }} class="project-card" data-project-priority={priority} data-project-order={order}>
	{details?.featured && <span class="featured-badge">Featured project</span>}
	<h1>{displayTitle}</h1>
	<p>{displayDesc}</p>
	<div class="tech-list">
		{displayLangs.map(lang => (
			<span class="lang">
				{lang.svg && <img src={`/${lang.svg}`} alt="" aria-hidden="true" />}
				{lang.name}
			</span>
		))}
	</div>
	<img class="preview" src={`/${displayImage}`} alt={displayTitle} />
	<section class="links">
		<a class="btn source" href={displaySource} target="_blank" rel="noreferrer"><img src="/Github.svg" alt="GitHub" /><span>Source</span></a>
		{displayLive ? (
			<a class="btn live" href={displayLive} target="_blank" rel="noreferrer"><img src="/live.svg" alt="Live" /><span>{liveLabel}</span></a>
		) : (
			<span class="btn no-live"><span>No Live</span></span>
		)}
	</section>
</article>

<script>
	const getContainer = () => document.querySelector("#Projects");
	const getCards = () => Array.from(document.querySelectorAll<HTMLElement>("#Projects .project-card"));

	const restoreOriginalOrder = () => {
		const container = getContainer();
		if (!container) return;
		getCards()
			.sort((a, b) => Number(a.dataset.projectOrder ?? 99) - Number(b.dataset.projectOrder ?? 99))
			.forEach(card => container.appendChild(card));
	};

	const sortProjects = () => {
		const container = getContainer();
		if (!container) return;
		getCards()
			.sort((a, b) => Number(a.dataset.projectPriority ?? 99) - Number(b.dataset.projectPriority ?? 99))
			.forEach(card => container.appendChild(card));
	};

	// Layout translates cards by their original DOM index. Always restore that
	// stable order before translation, then restore the visual priority order.
	const prepareForTranslation = () => {
		restoreOriginalOrder();
		setTimeout(sortProjects, 100);
	};

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", prepareForTranslation, { once: true });
	} else {
		prepareForTranslation();
	}

	document.addEventListener("click", event => {
		const button = event.target instanceof Element ? event.target.closest(".lang-btn") : null;
		if (button) prepareForTranslation();
	});
</script>

<style>
	article { width: 100%; margin: 54px auto; padding: 24px; border: 1px solid rgba(255,255,255,.07); border-radius: 22px; background: rgba(255,255,255,.025); box-shadow: 0 18px 55px rgba(0,0,0,.18); backdrop-filter: blur(10px); transition: transform .3s ease, border-color .3s ease, box-shadow .3s ease; color: aliceblue; position: relative; }
	.featured-project { border-color: rgba(127,90,240,.38); box-shadow: 0 20px 65px rgba(127,90,240,.12); }
	.featured-badge { display: inline-flex; align-items: center; margin-bottom: 12px; padding: 5px 10px; border: 1px solid rgba(127,90,240,.35); border-radius: 9999px; background: rgba(127,90,240,.12); color: #caaaff; font-size: .72rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
	h1 { position: relative; color: rgb(254 240 138); font-size: clamp(1.35rem, 2.2vw, 1.75rem); font-weight: 600; margin-bottom: 12px; padding-left: 20px; display: flex; align-items: center; overflow-wrap: anywhere; }
	h1::before { content: ""; flex: 0 0 10px; width: 10px; height: 10px; border-radius: 50%; background: rgb(254 240 138 / 90%); position: absolute; left: 0; top: 50%; transform: translateY(-50%); }
	p { font-size: clamp(.98rem, 1.3vw, 1.1rem); line-height: 1.6rem; margin-bottom: 25px; color: #dcdcdc; overflow-wrap: anywhere; }
	.tech-list { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 30px; }
	.lang { display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px; border-radius: 9999px; background: rgba(255,255,255,.08); font-size: .85rem; color: #ddd; backdrop-filter: blur(4px); line-height: 1; }
	.lang img { width: 16px; height: 16px; object-fit: contain; }
	.preview { display: block; margin: 40px auto 25px; max-width: 100%; max-height: 350px; border-radius: 12px; box-shadow: 0 15px 40px rgba(0,0,0,.3); }
	.links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 10px; }
	.btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-width: 0; padding: 10px 20px; border-radius: 9999px; font-size: 1rem; font-weight: 500; text-decoration: none; background: rgba(255,255,255,.06); color: white; backdrop-filter: blur(6px); transition: all .2s ease; line-height: 1.2; }
	.btn img { width: 20px; height: 20px; flex: 0 0 auto; }
	.btn:hover { transform: scale(1.05); background: rgba(255,255,255,.1); }
	.source { color: lightseagreen; } .live { color: limegreen; } .no-live { color: crimson; opacity: .5; cursor: default; pointer-events: none; background: rgba(255,255,255,.03); }
	@media (max-width: 850px) {
		article { margin: 30px auto; padding: 18px 14px; border-radius: 18px; }
		h1 { font-size: clamp(1.15rem, 5vw, 1.35rem); line-height: 1.3; }
		p { font-size: clamp(.9rem, 3.6vw, .98rem); line-height: 1.5rem; }
		.preview { margin: 26px auto 20px; width: 100%; height: auto; }
		.links { justify-content: stretch; }
		.btn { flex: 1 1 140px; padding: 9px 12px; font-size: clamp(.78rem, 3.2vw, .9rem); }
	}
	@media (max-width: 390px) { article { padding-inline: 12px; } .links { gap: 8px; } .btn { flex-basis: 100%; } }
	@media (prefers-reduced-motion: reduce) { .project-card, .btn { transition: none; } }
</style>